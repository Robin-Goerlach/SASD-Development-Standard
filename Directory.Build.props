<Project>
  <PropertyGroup>
    <!-- Gemeinsame, bewusst schlanke Build-Basis für alle Projekte der Solution. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Moderate, hohe und kritische NuGet-Auditfunde blockieren Restore und CI. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>

    <!-- In CI werden reproduzierbare Build-Metadaten erzeugt. Lokal bleibt das Debugging unverändert. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
