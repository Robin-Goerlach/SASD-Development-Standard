<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe verhindert, dass beim Start zusätzlich ein Konsolenfenster erscheint. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Der Build ist auch auf CI-Hosts möglich; ausgeführt wird die Anwendung weiterhin unter Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>TaskHostLocal.WinForms</AssemblyName>
    <RootNamespace>TaskHostLocal.WinForms</RootNamespace>
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Der Testcode darf ausschließlich interne Self-Check-Komponenten prüfen. -->
    <InternalsVisibleTo Include="TaskHostLocal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schlanker SQLite-Zugriff ohne Entity Framework. Die Version wird zentral verwaltet. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
